# Copy to .env locally. Never put real credentials in this example or in Git.
# GitHub extension: fine-grained token, scoped to only the repositories you need.
# Metadata: read; Contents: read/write; Pull requests: read/write; Issues: read/write.
# Add Workflows: write only if you explicitly need to change GitHub Actions files.
# Repository creation may require separate account/organization authorization.
GITHUB_TOKEN=

# Existing model adapters still accept their existing key store/environment options.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Local models and embeddings do not need a hosted-provider key.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional shared original GUI authentication; export in the launch environment.
# Do not reuse GitHub/provider credentials. Enroll once using nexus gui --remember-token.
NEXUS_SERVE_TOKEN=
# Legacy nexus hud alias accepts NEXUS_HUD_TOKEN only as a migration fallback.

# Optional private-chat bot. Environment only; never commit actual values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_PIN=

# WeatherAPI.com credential, server-side only; never put it in widget.yaml or chat.
WEATHERAPI_KEY=

# Optional personal assistant. Prefer an unlocked native OS keyring for account
# secrets; these blank environment variables are deployment examples only.
GOOGLE_OAUTH_ACCESS_TOKEN=
NOTION_TOKEN=
ELEVENLABS_API_KEY=
HOME_ASSISTANT_TOKEN=
PORCUPINE_ACCESS_KEY=
MQTT_PASSWORD=
# Explicit workers/backends remain off unless enabled at launch.
NEXUS_ASSISTANT_SCHEDULER=0
NEXUS_DESKTOP_ENABLED=0
NEXUS_GOOGLE_ENABLED=0
NEXUS_NOTIFY_VOICE=0
# Local model paths are required; Nexus never downloads these implicitly.
NEXUS_WHISPER_MODEL=
NEXUS_PIPER_MODEL=
NEXUS_KOKORO_VOICE=af_heart
NEXUS_EDGE_VOICE=bn-BD-NabanitaNeural
NEXUS_OBSIDIAN_VAULT=
