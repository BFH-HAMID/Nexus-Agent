# ─────────────────────────────────────────────────────────────────────────────
# Nexus Agent — environment
# Copy to `.env` and fill in. `.env` is git-ignored; `.env.example` is not.
# The CLI loads ./.env, <workspace>/.env and ~/.config/nexus/.env automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude (required for the default agent) ────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── GitHub (optional: only needed when the `gh` CLI is not installed) ──────
GITHUB_TOKEN=
# GH_TOKEN=

# ── Local models ───────────────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# HERMES_BIG_MODEL=hermes3:70b
#
# Pull what you need:
#   ollama pull hermes3:8b           # tool-capable local worker
#   ollama pull dolphin-mixtral      # uncensored, NO tool template -> tool_mode: text
#   ollama pull llama3.1:8b          # generic local fallback

# ── Optional hosted open models ────────────────────────────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b

# ── Behaviour overrides (see settings: in agents.yaml) ─────────────────────
# NEXUS_DEFAULT_AGENT=claude
# NEXUS_ROUTER_AGENT=claude-cheap
# NEXUS_AUTO_ROUTE=true
# NEXUS_ROUTER_LLM=true
# NEXUS_ROUTER_MIN_SCORE=1.0
# NEXUS_MAX_TURNS=24
# NEXUS_YES=false
# NEXUS_ALLOW_DANGEROUS=false
# NEXUS_MEMORY=true
# NEXUS_AUTO_BRANCH=true
# NEXUS_COMMAND_TIMEOUT=120
# NEXUS_HOME=~/.config/nexus
# NEXUS_WORKSPACE=.

# ── Sidebar / panel server ─────────────────────────────────────────────────
# NEXUS_SERVE_TOKEN=            # set this before binding 0.0.0.0
# NEXUS_SERVE_PORT=8787

# ── Misc ───────────────────────────────────────────────────────────────────
# NO_COLOR=1                  # disable ANSI colors
# HTTPS_PROXY=
